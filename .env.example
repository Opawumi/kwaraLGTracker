# Copy to .env.local and fill in. NEVER commit .env.local.

# Neon connection string (pooled or direct)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Random string, 32+ chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Used only by `npx prisma db seed` to create the first admin (password 12+ chars)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Administrator"

